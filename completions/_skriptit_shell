#compdef sgo svim sless scode

# Completion for the zsh helpers in shell/skriptit.zsh. Each helper takes a
# bookmark name as its first argument; the file openers pass everything after
# it to the opening program, which completes its own arguments.
_skriptit_shell() {
  local -a bookmarks
  local group

  (( CURRENT == 2 )) || return

  case "$service" in
    sgo) group=dirb ;;
    *) group=fileb ;;
  esac

  bookmarks=(${(f)"$(skriptit "$group" autocomplete entries 2>/dev/null)"})
  _describe "$group bookmark" bookmarks
}

if [[ "$funcstack[1]" == _skriptit_shell ]]; then
  _skriptit_shell "$@"
fi
