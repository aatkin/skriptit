#compdef skriptit s

_skriptit() {
  local -a groups commands bookmarks
  local group command

  group="${words[2]}"
  command="${words[3]}"

  if (( CURRENT == 2 )); then
    groups=(help ${(f)"$(skriptit autocomplete 2>/dev/null)"})
    _describe 'command group' groups
    return
  fi

  if (( CURRENT == 3 )); then
    if [[ "$group" == help ]]; then
      groups=(${(f)"$(skriptit autocomplete 2>/dev/null)"})
      _describe 'command group' groups
    else
      commands=(${(f)"$(skriptit autocomplete "$group" 2>/dev/null)"})
      _describe "$group command" commands
    fi
    return
  fi

  # Positions past the command name. Only the first of these is an existing
  # bookmark: `rename` takes a new, not-yet-existing key as its second.
  case "$group:$command" in
    dirb:read|dirb:remove|dirb:rename|fileb:read|fileb:remove|fileb:rename)
      if (( CURRENT == 4 )); then
        bookmarks=(${(f)"$(skriptit "$group" autocomplete entries 2>/dev/null)"})
        _describe "$group bookmark" bookmarks
      fi
      ;;
    fileb:save)
      (( CURRENT == 5 )) && _files
      ;;
    dirb:merge-defaults|fileb:merge-defaults)
      (( CURRENT == 4 )) && _files
      ;;
  esac
}

if [[ "$funcstack[1]" == _skriptit ]]; then
  _skriptit "$@"
fi
