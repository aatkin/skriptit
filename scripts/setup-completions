#!/usr/bin/env bash

set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd -P)}"
OMZ="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/zsh"

if [ -n "${SKRIPTIT_ZSH_COMPLETIONS_DIR:-}" ]; then
  DEST="$SKRIPTIT_ZSH_COMPLETIONS_DIR"
  completion_layout=custom
elif [ -d "$OMZ" ]; then
  DEST="$OMZ/completions"
  completion_layout=oh-my-zsh
else
  DEST="$ZSH_DATA_HOME/site-functions"
  completion_layout=standard
fi

mkdir -p "$DEST"
changed=0

for name in _skriptit _skriptit_shell; do
  source_file="$ROOT/completions/$name"
  target="$DEST/$name"

  if cmp -s "$source_file" "$target" 2>/dev/null; then
    echo "$name up to date"
  else
    install -m 0644 "$source_file" "$target"
    echo "wrote $target"
    changed=1
  fi
done

if [ "$changed" = 1 ]; then
  # compinit caches command-to-function mappings. Clear its generated cache so
  # the newly installed files are discovered by the next zsh.
  rm -f "${ZDOTDIR:-$HOME}"/.zcompdump*
  if [ "$completion_layout" = oh-my-zsh ]; then
    rm -f "$OMZ"/cache/.zcompdump*
  fi
  echo "cleared compinit cache — completions load in new shells"
fi

if [ "$completion_layout" = standard ]; then
  echo "add this before compinit in .zshrc:"
  echo "  fpath=(\"$DEST\" \$fpath)"
elif [ "$completion_layout" = custom ]; then
  echo "ensure $DEST is on zsh's fpath before compinit"
fi
